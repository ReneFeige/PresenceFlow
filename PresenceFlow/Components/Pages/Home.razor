@page "/"
@using PresenceFlow.Models
@implements IAsyncDisposable

<PageTitle>Anmeldung</PageTitle>

<div class="home-container">
    <div class="status-card">

        @if (!IsStorageAvailable)
        {
            <div class="alert alert-warning">
                ⚠️ Die Anwesenheitsdaten können momentan nicht geladen werden.<br />
                Anmeldung ist vorübergehend deaktiviert.
            </div>
        }
        else
        {
            @if (Person == null)
            {
                <img src="images/logo.png" alt="PresenceFlow Logo" class="logo" />
            }


            @if (IsLoading)
            {
                <p>⏳ Lade Daten…</p>
            }

            else if (Person != null)
            {
                <div class="person-name">
                    Hallo @Person.FirstName
                </div>

                <div class="person-status @(Person.Status == PresenceStatus.Present ? "anwesend" : "abwesend")">
                    @if (Person.Status == PresenceStatus.Present)
                    {
                        <span>🟢 Du bist aktuell anwesend</span>
                    }
                    else
                    {
                        <span>🔴 Du bist aktuell abwesend</span>
                    }
                </div>

                <button class="action-button @ButtonCssClass"
                        @onclick="LoginLogout"
                        disabled="@IsUpdating">

                    @(IsUpdating ? "⏳ Speichere..." : ButtonText)
                </button>

                @if (Success == false)
                {
                    <div class="alert alert-warning">
                        ⚠️ Die Anwesenheitsdaten können momentan nicht übermittelt werden.<br />
                        Anmeldung ist vorübergehend deaktiviert.
                    </div>
                }

                <div class="present-count">
                    Im Moment anwesend: <strong>@PresentCount</strong> 👥
                </div>

                <div class="logout-container">
                    <p class="logout-text">
                        Nicht @Person.FirstName? Gerät mit anderen teilen?
                    </p>

                    <button class="logout-button" @onclick="LogoutFromApp">
                        Logout
                    </button>
                </div>
            }
            else
            {
                <div class="not-logged-in">
                    <p>Willkommen!</p>
                    <p>Bitte melde dich an, um deine Anwesenheit zu erfassen.</p>
                    <NavLink href="/login" class="login-link">Jetzt anmelden</NavLink>
                </div>
            }
        }
    </div>

</div>
