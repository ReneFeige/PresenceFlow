@page "/"
@using PresenceFlow.Models
@implements IAsyncDisposable

<PageTitle>PresenceFlow</PageTitle>

<div class="home-container">

    <main class="status-card">

        @if (!IsStorageAvailable)
        {
            <section class="storage-error"
                     role="alert">

                <span class="status-icon"
                      aria-hidden="true">
                    ⚠️
                </span>

                <div>
                    <h1>Anwesenheitsdaten nicht verfügbar</h1>

                    <p>
                        Die Anwesenheitsdaten können momentan nicht geladen
                        werden. Die Anmeldung ist vorübergehend deaktiviert.
                    </p>
                </div>

            </section>
        }
        else
        {
            @if (Person == null)
            {
                <header class="brand-header">

                    <img src="images/logo.png"
                         alt="PresenceFlow"
                         class="logo" />

                    <p class="brand-claim">
                        Anwesenheit einfach erfassen.
                    </p>

                </header>
            }

            @if (IsLoading)
            {
                <section class="loading-state"
                         role="status"
                         aria-live="polite">

                    <span class="loading-spinner"
                          aria-hidden="true">
                    </span>

                    <p>Daten werden geladen…</p>

                </section>
            }
            else if (Person != null)
            {
                <section class="person-overview">

                    <header class="person-header">

                        <span class="section-eyebrow">
                            Anwesenheitsübersicht
                        </span>

                        <h1 class="person-name">
                            Hallo @Person.FirstName
                        </h1>

                        <p class="person-intro">
                            Hier kannst du deinen aktuellen
                            Anwesenheitsstatus verwalten.
                        </p>

                    </header>

                    <div class="person-status @(Person.Status == PresenceStatus.Present ? "anwesend" : "abwesend")">

                        <span class="status-indicator"
                              aria-hidden="true">
                        </span>

                        <div class="status-content">

                            <span class="status-label">
                                Aktueller Status
                            </span>

                            <strong>
                                @(Person.Status == PresenceStatus.Present
                                    ? "Anwesend"
                                    : "Abwesend")
                            </strong>

                        </div>

                    </div>

                    <button class="action-button @ButtonCssClass"
                            type="button"
                            @onclick="LoginLogout"
                            disabled="@IsUpdating">

                        @if (IsUpdating)
                        {
                            <span class="button-content">
                                <span class="button-spinner"
                                      aria-hidden="true">
                                </span>

                                <span>Speichere Status…</span>
                            </span>
                        }
                        else
                        {
                            <span class="button-content">
                                <span>@ButtonText</span>

                                <span class="button-arrow"
                                      aria-hidden="true">
                                    →
                                </span>
                            </span>
                        }

                    </button>

                    @if (Success == false)
                    {
                        <div class="status-message"
                             role="alert">

                            <span aria-hidden="true">⚠️</span>

                            <span>
                                Die Anwesenheitsdaten konnten momentan
                                nicht übermittelt werden. Bitte versuche
                                es später erneut.
                            </span>

                        </div>
                    }

                    <div class="present-count">

                        <span class="present-count-icon"
                              aria-hidden="true">
                            👥
                        </span>

                        <div>
                            <strong>@PresentCount</strong>

                            <span>
                                @(PresentCount == 1
                                    ? "Person ist aktuell anwesend"
                                    : "Personen sind aktuell anwesend")
                            </span>
                        </div>

                    </div>

                    <footer class="logout-container">

                        <p class="logout-text">
                            Nicht @Person.FirstName oder wird dieses Gerät
                            von mehreren Personen verwendet?
                        </p>

                        <button class="logout-button"
                                type="button"
                                @onclick="LogoutFromApp">
                            Abmelden
                        </button>

                    </footer>

                </section>
            }
            else
            {
                <section class="not-logged-in">

                    <span class="section-eyebrow">
                        Sicherer Zugang
                    </span>

                    <h1>Willkommen</h1>

                    <p>
                        Melde dich an, um deine Anwesenheit einfach und
                        sicher zu erfassen.
                    </p>

                    <NavLink href="/login"
                             class="login-link">
                        <span>Jetzt anmelden</span>

                        <span aria-hidden="true">
                            →
                        </span>
                    </NavLink>

                    <div class="login-note">
                        <span aria-hidden="true">🔒</span>

                        <span>
                            Die Anmeldung erfolgt ohne Passwort.
                        </span>
                    </div>

                </section>
            }
        }

    </main>

</div>