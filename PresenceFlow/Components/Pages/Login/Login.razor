@page "/login"

<PageTitle>Anmeldung</PageTitle>

<div class="login-container">

    <div class="login-card">

        <NavLink href="/" class="back-link">
            ← Zurück
        </NavLink>

        <h2 class="title">Anmeldung</h2>

        <p class="subtitle">
            Bitte geben Sie Ihre E-Mail-Adresse ein.
        </p>

        @if (IsUiDemo)
        {
            <div class="demo-hint">
                <strong>Portfolio-Demo</strong>

                <p>Benutzer:</p>
                <button class="demo-email-button" @onclick="() => UseDemoEmail(UserDemoEmail)">
                    @UserDemoEmail
                </button>

                <p>Administrator:</p>
                <button class="demo-email-button" @onclick="() => UseDemoEmail(AdminDemoEmail)">
                    @AdminDemoEmail
                </button>
            </div>
        }

        <input class="email-input"
               type="email"
               placeholder="E-Mail-Adresse"
               @bind="Email"
               disabled="@IsBusy" />

        <button class="login-button"
                @onclick="SendLink"
                disabled="@IsBusy">
            @if (IsBusy)
            {
                <span>Wird gesendet…</span>
            }
            else
            {
                <span>Login-Link senden</span>
            }
        </button>

        @if (Message != null && LoginLink == null)
        {
            <div class="@MessageCssClass"
                 role="alert">
                @Message
            </div>
        }

        @if (LoginLink != null)
        {
            <div class="magic-link-container">

                <div class="alert alert-warning" role="alert">
                    <strong>Lokaler Demo-Modus</strong>

                    <p class="mb-2">
                        Der Anmeldelink wird direkt in dieser Oberfläche
                        angezeigt und nicht per E-Mail versendet.
                    </p>

                    <p class="mb-0">
                        Für eine sichere Anmeldung im Produktivbetrieb muss
                        ein E-Mail-Service konfiguriert und der
                        Magic-Link-Provider auf
                        <code>Email</code> gesetzt werden.
                    </p>
                </div>

                <a href="@LoginLink"
                   class="login-link">
                    Jetzt anmelden
                </a>

            </div>
        }

    </div>

</div>
