@page "/actualpresent"
@implements IAsyncDisposable

<PageTitle>Anwesende</PageTitle>

<div class="present-container">
    <div class="present-content">

        <NavLink href="/" class="back-link">← Zur Anmeldung</NavLink>

        <h2 class="title">Anwesende Personen</h2>

        @if (IsLoading)
        {
            <p class="info-text">⏳ Lade Daten…</p>
        }
        else
        {
            <div class="subtitle">
                Im Moment anwesend: <strong>@PresentCount</strong> 👥
            </div>

            @if (PresentPeople.Count == 0)
            {
                <p class="info-text">
                    Im Moment ist niemand anwesend.
                </p>
            }
            else
            {
                <div class="person-list-wrapper">
                    <ul class="person-list">
                        @foreach (var person in PresentPeople)
                        {
                            <li class="person-item">
                                <div class="person-name">
                                    👤 @GetDisplayName(person)
                                </div>

                                <div class="person-time">
                                    @GetPresenceTimeText(person)
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }
        }

    </div>
</div>
