@page "/login"

<PageTitle>Anmeldung</PageTitle>

<div class="login-container">

    <div class="login-card">

        <NavLink href="/" class="back-link">
            ← Zurück
        </NavLink>

        <h2 class="title">Anmeldung</h2>

        <p class="subtitle">
            Bitte geben Sie Ihre E-Mail-Adresse ein.
        </p>

        <input class="email-input"
               type="email"
               placeholder="E-Mail-Adresse"
               @bind="Email"
               disabled="@IsBusy" />

        <button class="login-button"
                @onclick="SendLink"
                disabled="@IsBusy">
            @if (IsBusy)
            {
                <span>Wird gesendet…</span>
            }
            else
            {
                <span>Login-Link senden</span>
            }
        </button>

        @if (Message != null)
        {
            <p class="message">
                @Message
            </p>
        }

        @if (LoginLink != null)
        {
            <div class="magic-link-container">
                <p>
                    Der lokale Anmeldelink wurde erstellt:
                </p>

                <a href="@LoginLink"
                   class="login-link">
                    Jetzt anmelden
                </a>
            </div>
        }

    </div>

</div>
